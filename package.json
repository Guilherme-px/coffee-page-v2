        "lint:eslint": "eslint . --fix --cache",
        "format": "oxfmt ."
    },
    "dependencies": {
        "@nuxt/a11y": "1.0.0-alpha.1",
        "@nuxt/eslint": "1.17.0",
        "@nuxt/image": "2.1.0",
