        "eslint": "^9.0.0 || ^10.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-oxlint": "^1.80.0",
        "jsdom": "^30.0.1",
        "oxfmt": "0.65.0",
        "oxlint": "^1.80.0",
        "tailwindcss": "^4.0.0",
        "typescript": "6",
        "vitest": "^4.1.11"
